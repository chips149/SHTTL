  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u5236\u4F5C\u65B9\uFF1A\r\n\u5409\u6797\u52A8\u753B\u5B66\u9662\u6E38\u620F\u5B66\u9662-\u6E38\u620F\u5B75\u5316\u56E2\u961F\r\n\u53D1\u884C\u65B9\uFF1A\r\n\u5409\u6797\u5409\u52A8\u76D8\u53E4\u7F51\u7EDC\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\r\n\u9879\u76EE\u603B\u8D1F\u8D23\u4EBA\uFF1A\u5B89\u5B81\r\n\u6267\u884C\u8D1F\u8D23\u4EBA\uFF1A\u674E\u5CA9\r\n=========\u9879\u76EE\u7EC4\u6210\u5458==========\r\n\u9879\u76EE\u6307\u5BFC\u6559\u5E08\uFF1A\u674E\u5CA9\u3001\u71D5\u9752\r\n\u7B56\u5212\u8D1F\u8D23\u4EBA\uFF1A\u6BD5\u98DE\u6768 
    \u7F8E\u672F\u8D1F\u8D23\u4EBA\uFF1A\u71D5\u9752\r\n\u7A0B\u5E8F\u8D1F\u8D23\u4EBA\uFF1A\u5F20\u99A8\u6708\r\n\u7B56\u5212\u7EC4\uFF1A\u738B\u4E49\u535A\u3001\u6BD5\u98DE\u6768\r\n\u7F8E\u672F\u7EC4\uFF1A\u6BDB\u5B87\u6167\u3001\u5510\u57F9\u96EF\u3001\u9648\u6CEF\u6C5F\u3001\r\n\u5F20\u4F51\u8BDA\u3001\u53F6\u598D\u82B3\u3001\u71D5\u9752\r\n\u7A0B\u5E8F\u7EC4\uFF1A
    \u5F20\u99A8\u6708\u3001\u6BCD\u6653\u83F2\u3001\u674E\u5CA9\u3001\u90D1\u4F1F\u4E1C\r\n=======\u6E38\u620F\u5B75\u5316\u56E2\u961F\u6210\u5458========\r\n\u7B56\u5212\u56E2\u961F\uFF1A\u674E\u5CA9\u3001\u738B\u4E49\u535A\u3001\u6BD5\u98DE\u6768\u3001\u82D7\u632F\u626C\u3001\u5173\u68EE\r\n\u4E8C\u7EF4\u7F8E\u672F\u56E2\u961F\uFF1A\u71D5\u9752\u3001\u6BDB\u5B87\u6167\r\n\u4E09\u7EF4\u7F8E\u672F\u56E2\u961F\uFF1A\u9AD8\u57F9\u5C27\r\n\u7279\u6548\u56E2\u961F\uFF1A\u53F6\u598D\u82B3\u3001\u5510\u57F9\u96EF\u3001\u5F20\u4F51\u57CE\r\n\u52A8\u4F5C\u56E2\u961F\uFF1A\u9648\u6CEF\u6C5F\r\n\u7A0B\u5E8F\u56E2\u961F\uFF1A\u5F20\u99A8\u6708\u3001\u90DD\u771F\u61FF\u3001\u6BCD\u6653\u83F2\u3001\r\n\u674E\u5353\u6F8E\u3001\u8303\u7EAF\u4F51\r\n\u97F3\u4E50\u97F3\u6548\u7EC4\uFF1A\u5173\u68EE\u3001\u82D7\u632F\u626C\u3001\u738B\u4E49\u535A\u3001\u6BD5\u98DE\u6768\r\n\u97F3\u4E50\u97F3\u6548\u7EC4\uFF1A\u6BD5\u98DE\u6768\r\n=======\u7279\u522B\u9E23\u8C22========\r\n\u90D1\u4F1F\u4E1C\u5148\u751F\u5BF9\u8BE5\u9879\u76EE\u5236\u4F5C\u7684\u5927\u529B\u652F\u6301\uFF01\r\n\r\n\r\n\r\n===\u611F\u8C22\u60A8\u7684\u6E38\u73A9\uFF0C\u795D\u60A8\u6E38\u620F\u6109\u5FEB\uFF01===\r"
